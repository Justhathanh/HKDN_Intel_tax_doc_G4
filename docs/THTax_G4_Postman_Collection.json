    {
      "name": "3. UPLOAD",
      "item": [
        {
          "name": "TC-UP-01 Upload PDF hợp lệ",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Tạo UUID mới cho TC-UP-01 và lưu để TC-UP-03 dùng lại",
                  "function uuid() {",
                  "    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                  "        var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);",
                  "        return v.toString(16);",
                  "    });",
                  "}",
                  "var key = uuid();",
                  "pm.collectionVariables.set('idempotency_key_01', key);",
                  "pm.request.headers.upsert({ key: 'Idempotency-Key', value: key });",
                  "console.log('Idempotency-Key TC-UP-01:', key);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-UP-01: Status 201 Created', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('TC-UP-01: Có document_id, sha256, status=received', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('document_id');",
                  "    pm.expect(json).to.have.property('sha256');",
                  "    pm.expect(json.status).to.eql('received');",
                  "    pm.expect(json.duplicate).to.eql(false);",
                  "    pm.collectionVariables.set('document_id', json.document_id);",
                  "    console.log('document_id đã lưu:', json.document_id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-user", "value": "{{x_user}}" },
              { "key": "x-client-ids", "value": "{{client_id}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Chọn file: docs/test/files/valid_invoice_2p.pdf trong repo"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/batches/{{batch_id}}/documents",
              "host": ["{{base_url}}"],
              "path": ["batches", "{{batch_id}}", "documents"]
            }
          }
