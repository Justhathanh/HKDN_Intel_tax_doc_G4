              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-GD-01: Status 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('TC-GD-01: Có đủ các trường bắt buộc', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('document_id');",
                  "    pm.expect(json).to.have.property('sha256');",
                  "    pm.expect(json).to.have.property('status');",
