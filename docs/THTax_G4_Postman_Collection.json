    {
      "name": "5. BẢO MẬT",
      "item": [
        {
          "name": "TC-BM-01 Upload XML chứa XXE",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "function uuid() {",
                  "    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                  "        var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);",
                  "        return v.toString(16);",
                  "    });",
                  "}",
                  "pm.request.headers.upsert({ key: 'Idempotency-Key', value: uuid() });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-BM-01: Bị chặn/cách ly XML chứa XXE (422 unsafe_xml)', function() {",
                  "    pm.response.to.have.status(422);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error_code).to.eql('unsafe_xml');",
                  "});",
                  "pm.test('TC-BM-01: Response không chứa nội dung hệ thống bị rò rỉ', function() {",
                  "    var body = pm.response.text();",
                  "    pm.expect(body).to.not.include('root:');",
                  "    pm.expect(body).to.not.include('/bin/bash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-user", "value": "{{x_user}}" },
              { "key": "x-client-ids", "value": "{{client_id}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "", "description": "Chọn file: docs/test/files/unsafe_xxe.xml trong repo" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/batches/{{batch_id}}/documents",
              "host": ["{{base_url}}"],
              "path": ["batches", "{{batch_id}}", "documents"]
            }
          }
        },
