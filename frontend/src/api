// G4T-13: gọi API upload tài liệu

export const MAX_BYTES = 20 * 1024 * 1024;
export const ACCEPT = ".pdf,.jpg,.jpeg,.png,.xml";
const EXTENSIONS = ["pdf", "jpg", "jpeg", "png", "xml"];

export type DocumentReceipt = {
  document_id: string;
  submission_id: string;
  batch_id: string;
  file_name: string;
  size: number;
  sha256: string;
  mime_type: string;
  page_count: number | null;
  channel: string;
  uploaded_by: string;
  status: string;
  duplicate: boolean;
  received_at: string;
};

type ApiErrorBody = {
  error_code: string;
  message: string;
  submission_id: string | null;
  document_id: string | null;
};

export class UploadError extends Error {
  code: string;
  status: number;
  documentId: string | null;

  constructor(code: string, message: string, status = 0, documentId: string | null = null) {
    super(message);
    this.code = code;
    this.status = status;
    this.documentId = documentId;
  }
}

const MESSAGES: Record<string, string> = {
  unauthenticated: "Bạn chưa đăng nhập.",
  empty_file: "File rỗng. Hãy chọn file khác.",
  file_too_large: "File vượt quá 20 MiB. Hãy chọn file nhỏ hơn.",
  unsupported_format: "Chỉ nhận file PDF, JPG, PNG hoặc XML.",
  too_many_pages: "PDF vượt quá 30 trang. Hãy tách nhỏ file rồi tải lại.",
  password_protected: "PDF có mật khẩu. Hãy bỏ mật khẩu rồi tải lại.",
  corrupt_file: "File bị hỏng, không đọc được. Hãy kiểm tra file rồi tải lại.",
  network_error: "Mất kết nối đến máy chủ. Hãy kiểm tra mạng rồi thử lại.",
  config_error: "Thiếu VITE_API_BASE_URL trong file .env.",
};

export function messageFor(code: string, fallback: string): string {
  return MESSAGES[code] ?? fallback;
}

export function validateFile(file: File): string | null {
  const ext = file.name.includes(".") ? file.name.split(".").pop()!.toLowerCase() : "";
  if (!EXTENSIONS.includes(ext)) return "unsupported_format";
  if (file.size === 0) return "empty_file";
  if (file.size > MAX_BYTES) return "file_too_large";
  return null;
}

function authHeaders(): Record<string, string> {
  const headers: Record<string, string> = {};
  const user = import.meta.env.VITE_DEV_USER;
  const clientIds = import.meta.env.VITE_DEV_CLIENT_IDS;
  if (user) headers["X-User"] = user;
  if (clientIds) headers["X-Client-Ids"] = clientIds;
  return headers;
}

export function uploadDocument(
  batchId: string,
  file: File,
  idempotencyKey: string,
  onProgress?: (percent: number) => void,
): Promise<DocumentReceipt> {
  return new Promise((resolve, reject) => {
    const base = import.meta.env.VITE_API_BASE_URL;
    if (!base) {
      reject(new UploadError("config_error", messageFor("config_error", "")));
      return;
    }

    const form = new FormData();
    form.append("file", file); // gửi nguyên file gốc, không chỉnh sửa

    const xhr = new XMLHttpRequest();
    xhr.open("POST", `${base}/batches/${encodeURIComponent(batchId)}/documents`);
    xhr.responseType = "json";
    xhr.setRequestHeader("Idempotency-Key", idempotencyKey);
    for (const [name, value] of Object.entries(authHeaders())) xhr.setRequestHeader(name, value);

    xhr.upload.onprogress = (event) => {
      if (event.lengthComputable && onProgress) {
        onProgress(Math.round((event.loaded * 100) / event.total));
      }
    };

    xhr.onload = () => {
      // 201: file mới. 200: file đã có, duplicate = true.
      if (xhr.status === 200 || xhr.status === 201) {
        resolve(xhr.response as DocumentReceipt);
        return;
      }
      const body = xhr.response as Partial<ApiErrorBody> | null;
      const code = body?.error_code ?? "server_error";
      const fallback = body?.message ?? "Máy chủ gặp lỗi. Hãy thử lại sau.";
      reject(new UploadError(code, messageFor(code, fallback), xhr.status, body?.document_id ?? null));
    };

    xhr.onerror = () => reject(new UploadError("network_error", messageFor("network_error", "")));
    xhr.send(form);
  });
}
